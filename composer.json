{
    "name": "nextcloud/integration_jmapc",
    "description": "JMAP Connector",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Sebastian Krupinski",
            "email": "krupinski01@gmail.com",
            "homepage": "https://github.com/SebastianKrupinski/integration_jmapc",
            "role": "Just another Minion in the cogs of time"
        }
    ],
    "require": {
        "php": ">=8.2 <=8.5",
        "sebastiankrupinski/jmap-client-php": "^2.4.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "autoloader-suffix": "JMAPC",
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "OCA\\JMAPC\\": "lib/"
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "php ./vendor/bin/psalm.phar --config=psalm.xml --no-cache --threads=$(nproc)",
        "psalm:dev": "@psalm",
        "psalm:baseline": "php ./vendor/bin/psalm.phar --config=psalm.xml --threads=1 --update-baseline",
        "psalm:fix": "php ./vendor/bin/psalm.phar --config=psalm.xml --alter --no-cache --threads=1",
        "test:unit": "phpunit -c tests/php/phpunit.xml --testsuite 'Unit Tests'",
        "test:integration:db": "phpunit -c tests/php/phpunit.xml --testsuite 'Database Tests'",
        "test:integration:jmap": "phpunit -c tests/php/phpunit.xml --testsuite 'JMAP Tests'",
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all install --ansi"
        ]
    }
}
